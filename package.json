{
  "name": "grocery-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev",
    "build": "dotenv -e .env -- next build",
    "start": "dotenv -e .env -- next start -H 0.0.0.0",
    "lint": "eslint",
    "test": "dotenv -e .env.test -- cypress run",
    "test:open": "dotenv -e .env.test -- cypress open",
    "seed": "dotenv -e .env.dev -- pnpm prisma db seed",
    "seed:test": "dotenv -e .env.test -- pnpm prisma db seed"
  },
  "dependencies": {
    "@babylonjs/core": "^8.55.3",
    "@babylonjs/loaders": "^8.55.3",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@supabase/supabase-js": "^2.100.0",
    "@tanstack/react-query": "^5.91.3",
    "argon2": "^0.44.0",
    "dotenv": "^17.3.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "mailgun.js": "^12.7.1",
    "motion": "^12.37.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-toastify": "^11.0.5",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.91.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^15.13.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
